rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Passenger profile access (Firebase Auth uid == document id)
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Driver profile access (Firebase Auth uid == document id)
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == driverId;
    }

    // Legacy/alt guides directory & verified credentials
    match /guides/{guideId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == guideId;
    }

    // Passenger trip preferences (Firebase Auth uid == document id)
    match /tripPreferences/{prefId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == prefId;
    }

    // Digital Handshakes — Append-only verified encounter ledger
    match /handshakes/{handshakeId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.guideId is string
                    && request.resource.data.travelerId is string;
      allow update, delete: if false; // Tamper-evident: Cannot be altered once written
    }

    // Proof-of-Presence Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.guideId is string
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if false; // Reviews cannot be silently modified
    }

    // Live Price Pulse — post-handshake price submissions
    match /pricePulse/{pulseId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // Digital Footprint records (passenger trip legs w/ driver)
    match /digitalFootprints/{footprintId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Scam Hotspots & Danger Zones
    match /hotspots/{hotspotId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Emergency SOS & Tourist Police Evidence Dossiers
    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if true; // Always allow immediate emergency panic logging
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
